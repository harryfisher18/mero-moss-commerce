# Mero & Moss environment variables.
# DEMO mode needs none of these. Copy to .env.local to override defaults.
# Never commit real secrets.

# Path of the local SQLite demo database (default: .data/mero-moss.db)
# MERO_MOSS_DB_PATH=.data/mero-moss.db
# Relative paths resolve against the project root.

# Merchant console login. Leave both unset to use the public demo login
# (merchant@meroandmoss.example / moss-demo-2026), which the login page displays.
# Generate the hash with: npm run merchant:hash -- "<password>"
# MERCHANT_EMAIL=owner@example.com
# MERCHANT_PASSWORD_HASH=scrypt$16384$8$1$<salt>$<hash>

# Shopping advisor: optional assisted wording with Claude. Leave unset for the fully
# functional catalog-only advisor (DEMO). Calls are paid, rate-limited to 20 per minute
# per server process, and every reply is validated against catalog facts.
# ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-opus-5-5
# Content Studio uses the same key for optional AI drafts (10 per minute per process).
# CONTENT_MODEL=claude-opus-5-5
